<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@android:color/white"
    >

    <!-- Layout para el preview -->
    <LinearLayout
        android:id="@+id/layout_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layout_botones">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="550dp"
            android:layout_margin="30dp"/>
    </LinearLayout>

    <!-- Layout para los botones -->
    <LinearLayout
        android:id="@+id/layout_botones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/layout_preview"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/botonC"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginRight="30dp"
            android:layout_marginLeft="150dp"
            android:background="#00000000"
            android:src="@drawable/camara"
            android:scaleType="fitXY"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/registro"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginRight="50dp"
            android:background="#00000000"
            android:src="@drawable/registro"
            android:scaleType="fitXY"
            android:layout_weight="2"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
